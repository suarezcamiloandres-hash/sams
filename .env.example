# Shopify Storefront API — create these in the Shopify admin:
# Settings → Apps and sales channels → Develop apps → Create app →
# Configure Storefront API scopes → Install → copy the Storefront access token.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=sams-coffee.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
