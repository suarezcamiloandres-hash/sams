# Shopify Storefront API — create these in the Shopify admin:
# Settings → Apps and sales channels → Develop apps → Create app →
# Configure Storefront API scopes → Install → copy the Storefront access token.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=sams-coffee.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API token (SERVER-ONLY secret — do NOT prefix with NEXT_PUBLIC).
# Used only to save newsletter emails from the 10%-off popup.
# Shopify admin → Settings → Apps and sales channels → Develop apps →
# your app → Configuration → Admin API → enable "write_customers" → Install →
# API credentials → copy the "Admin API access token".
# Leave blank to launch the popup without saving emails yet.
SHOPIFY_ADMIN_API_TOKEN=
